[Unit]
Description=VALHEM Online Server
After=network.target

[Service]
Type=simple
User=valhem
Group=valhem
WorkingDirectory=/opt/valhem/app
EnvironmentFile=/opt/valhem/config/valhem.env
ExecStart=/usr/bin/node src/server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/valhem/data

[Install]
WantedBy=multi-user.target
