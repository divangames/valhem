[Unit]
Description=VALHEM Online Server
After=network.target

[Service]
Type=simple
User=valhem
Group=valhem
WorkingDirectory=/opt/valhem-online
EnvironmentFile=/etc/valhem-online.env
ExecStart=/usr/bin/node src/server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/valhem-online

[Install]
WantedBy=multi-user.target
